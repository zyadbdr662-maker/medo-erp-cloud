# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_ENV: Defines isolation between Admin and Customer
# Set to 'development' to reveal Admin/SaaS modules.
# Set to 'production' (or leave empty) to isolate and hide them.
VITE_APP_ENV="production"

VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_ID=
VITE_HOTJAR_ID=
VITE_FB_PIXEL_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_APP_CHECK_KEY=

# Sovereign Admin & Tenant Encryption Keys (AES-256 + PBKDF2)
ADMIN_ENCRYPTION_KEY="medo_sovereign_master_aes256_key_2026_badr"
ADMIN_2FA_SECRET="JBSWY3DPEHPK3PXP"
TENANT_ENCRYPTION_KEY="medo_tenant_shared_aes256_encryption_key_2026"
TENANT_SESSION_KEY="medo_tenant_session_secret_jwt_key_2026"
SESSION_ENCRYPTION_KEY="medo_enterprise_session_aes256_secure_key"
JWT_SECRET="medo_cloud_erp_jwt_signing_token_secret_2026"

# Security & Rate Limiting Thresholds
MAX_LOGIN_ATTEMPTS_ADMIN=3
MAX_LOGIN_ATTEMPTS_TENANT=5
LOCKOUT_DURATION=3600

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="zyadbdr925@gmail.com"
SMTP_PASS=
SMTP_FROM="MeDo ERP Security <zyadbdr925@gmail.com>"
RESEND_API_KEY=
