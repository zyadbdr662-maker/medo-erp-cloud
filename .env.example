# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_ENV: Defines isolation between Admin and Customer
# Set to 'development' to reveal Admin/SaaS modules.
# Set to 'production' (or leave empty) to isolate and hide them.
VITE_APP_ENV="production"

VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_ID=
VITE_HOTJAR_ID=
VITE_FB_PIXEL_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_FIREBASE_APP_CHECK_KEY=

# Sovereign Admin Email Dispatcher (SMTP / Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="zyadbdr925@gmail.com"
SMTP_PASS=
SMTP_FROM="MeDo ERP Security <zyadbdr925@gmail.com>"
RESEND_API_KEY=
